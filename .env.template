# Firebase Web App configuration (client-side, injected at build time by Vite).
# Copy this file to `.env` and fill in the values from your Firebase project's
# web app config (Firebase console -> Project settings -> Your apps -> SDK setup).
# These VITE_-prefixed values are embedded in the client bundle and are not secret,
# but the app cannot connect to Firebase (Auth / Firestore / Functions / Storage)
# without them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
