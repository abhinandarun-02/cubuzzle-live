rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /competitions/{competitionId}/competitors/{competitorId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // Global serial for Cubuzzle IDs (YY + MM + serial + initials).
    match /counters/userIdCounter {
      allow read: if true;
      allow write: if false;
    }

    // Everything else
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
